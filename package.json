{
  "name": "vega-datasets",
  "version": "3.2.1",
  "description": "Common repository for example datasets used by Vega related projects.",
  "license": "BSD-3-Clause",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+http://github.com/vega/vega-datasets.git"
  },
  "author": {
    "name": "Vega",
    "url": "https://vega.github.io"
  },
  "funding": {
    "url": "https://app.hubspot.com/payments/GyPC972GD9Rt"
  },
  "exports": {
    "types": "./build/index.d.ts",
    "default": "./build/index.js"
  },
  "unpkg": "build/vega-datasets.min.js",
  "jsdelivr": "build/vega-datasets.min.js",
  "files": [
    "src",
    "build",
    "data",
    "datapackage.json"
  ],
  "dependencies": {
    "d3-dsv": "^3.0.1"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/d3-dsv": "^3.0.7",
    "datalib": "^1.9.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^16.2.7",
    "lz-string": "^1.5.0",
    "marked": "^18.0.14",
    "release-it": "^21.0.1",
    "rollup": "^4.47.1",
    "rollup-plugin-bundle-size": "^1.0.3",
    "typescript": "^6.0.2",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-interpreter": "^2.3.2",
    "vega-lite": "^6.4.3",
    "vitest": "^5.0.2"
  },
  "scripts": {
    "prebuild": "./scripts/make-url-index.sh > src/urls.ts && ./scripts/build_datapackage.py",
    "build": "rollup -c",
    "github": "python scripts/github.py",
    "release": "release-it",
    "prepare": "husky",
    "update-gallery": "uv run scripts/generate_gallery_examples.py",
    "site:build": "uv run --group site scripts/build_site_catalog.py && rollup -c site/rollup.config.mjs",
    "site:bundle": "rollup -c site/rollup.config.mjs",
    "site:serve": "node site/scripts/serve.mjs",
    "site:test": "vitest run --config site/vitest.config.ts --project unit",
    "site:check-links": "vitest run --config site/vitest.config.ts --project links"
  },
  "lint-staged": {
    "*.py": ["uv run ruff check --fix", "uv run ruff format"]
  }
}
