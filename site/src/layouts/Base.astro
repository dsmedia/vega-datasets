---
/**
 * Every page: the head (title, description, canonical URL, link-preview tags), the Vega
 * family header, the footer, and the page's JSON-LD (at the end, so the head stays short). Scripts are external files only (the CSP
 * allows nothing else); theme-init.js runs before the stylesheet so a saved dark
 * choice paints without a flash.
 */
import "../styles/site.css";
import { HOME_URL, jsonForScript, noindex as keepOut, SITE_NAME } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  /** The page's path relative to the home page ("" for home). */
  path: string;
  /** Which header link is current: the home page, or a page inside Datasets. */
  section: "home" | "dataset" | "none";
  jsonLd?: Record<string, unknown>[];
}

const { title, description, path, section, jsonLd = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(path, HOME_URL).href;
// Deployments other than vega/vega-datasets (forks, previews) stay out of search results.
const noindex = keepOut(process.env);
const current = section === "home" ? "page" : section === "dataset" ? "true" : undefined;
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'none'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{noindex && <meta name="robots" content="noindex">}
<meta property="og:site_name" content={SITE_NAME}>
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta name="twitter:card" content="summary">
<meta name="theme-color" content="#234a3b">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%23234a3b'/%3E%3Cpath d='M4 11h2V7H4zm3 0h2V4H7zm3 0h2V8h-2z' fill='%23fff'/%3E%3C/svg%3E">
<link rel="sitemap" type="application/xml" href={`${base}sitemap.xml`}>
<script is:inline src={`${base}theme-init.js`}></script>
<slot name="head" />
</head>
<body>
<header class="vg-header">
  <nav class="vg-nav" aria-label="Site">
    <div class="vg-switcher">
      <a class="vg-title" href={base}>vega-datasets</a>
      <div class="vg-switcher-menu">
        <a href="https://vega.github.io/vega/">Vega</a>
        <a href="https://vega.github.io/vega-lite/">Vega-Lite</a>
        <a href="https://altair-viz.github.io/">Altair</a>
        <a href="https://vega.github.io/vega-lite-api/">Vega-Lite API</a>
      </div>
    </div>
    <div class="vg-primary">
      <a href={base} aria-current={current}>Datasets</a>
      <a href="https://github.com/vega/vega-datasets/blob/main/CONTRIBUTING.md">Contributing</a>
    </div>
    <div class="vg-secondary">
      <a href="https://github.com/vega/vega-datasets">GitHub</a>
      <a href="https://vega.github.io/editor/" data-wide>Try Online</a>
      <a href="https://vega.github.io/">About Vega</a>
      <button class="vg-theme" id="theme-toggle" type="button" aria-pressed="false" aria-label="Dark mode" title="Dark mode">
        <svg class="icon-moon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M13.5 10.2A6 6 0 0 1 5.8 2.5a6 6 0 1 0 7.7 7.7z" fill="currentColor"/></svg>
        <svg class="icon-sun" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="8" cy="8" r="3.2" fill="currentColor"/><path d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.05 3.05l1.13 1.13M11.82 11.82l1.13 1.13M3.05 12.95l1.13-1.13M11.82 4.18l1.13-1.13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
    </div>
  </nav>
</header>
<main id="page" tabindex="-1">
  <slot />
</main>
<footer class="vg-footer">
  <div class="wrap footer-row">
    <p id="footer-note"><slot name="footer" /></p>
    <a class="idl-logo" href="https://idl.cs.washington.edu/" title="UW Interactive Data Lab"><img src={`${base}idl-logo.png`} width="75" height="54" alt="UW Interactive Data Lab"></a>
  </div>
</footer>
{jsonLd.map((ld) => <script type="application/ld+json" set:html={jsonForScript(ld)} />)}
<script>
  import "../client/common";
</script>
</body>
</html>
